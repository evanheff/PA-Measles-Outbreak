```{r, Setup Data}
vax_rates <- read_excel("PA Measles Outbreak Analysis.xlsx", sheet = "Kindergarten MMR Vax Rates")
case_counts <- read_excel("PA Measles Outbreak Analysis.xlsx", sheet = "Case Counts (9-16)") #Change Date Here
population_density <- read_excel("PA Measles Outbreak Analysis.xlsx", sheet = "Population Density")
pa_data <- vax_rates %>%
  left_join(case_counts, by = "county") %>%
  left_join(population_density, by =  "county") %>%
  mutate(
    cases_per_100k = `case count` / population * 100000,
    below_herd_immunity = `vaccination rate` < 0.95
  )
```

