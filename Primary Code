```{r, Spatial Autocorrelation}
pa_counties <- counties(state = "PA", cb = TRUE, year = 2022, class = "sf") %>%
  dplyr::select(county = NAME, geometry)
pa_spatial <- pa_counties %>%
  left_join(case_counts %>% dplyr::select(county, `case count`), by = "county") %>%
  mutate(`case count` = replace_na(`case count`, 0))
# Moran's I
nb <- poly2nb(pa_spatial, queen = TRUE)
lw <- nb2listw(nb, style = "W", zero.policy = TRUE)
moran.test(pa_spatial$`case count`, lw, zero.policy = TRUE)
# Local Moran's I
local_moran <- localmoran(pa_spatial$`case count`, lw, zero.policy = TRUE)
pa_spatial$local_i <- local_moran[, "Ii"]
pa_spatial$local_p <- local_moran[, "Pr(z != E(Ii))"]
pa_spatial %>%
  st_drop_geometry() %>%
  filter(local_p < 0.05) %>%
  arrange(desc(local_i)) %>%
  dplyr::select(county, `case count`, local_i, local_p) %>%
  kable(digits = 3, caption = "Counties forming statistically significant local spatial clusters (p < 0.05)")
local_clusters <- pa_spatial %>%
  st_drop_geometry() %>%
  filter(local_p < 0.05) %>%
  mutate(
    cluster_type = if_else(local_i > 0, "High-high cluster", "Outlier (low amid high)")
  ) %>%
  arrange(desc(local_i)) %>%
  dplyr::select(county, cluster_type, `case count`, local_i, local_p)

local_clusters %>%
  kable(digits = 3, caption = "Counties forming statistically significant local spatial clusters (p < 0.05)") %>%
  kable_styling(bootstrap_options = c("striped", "hover"), full_width = FALSE) %>%
  column_spec(3, background = spec_color(local_clusters$`case count`, option = "plasma", direction = -1)) %>%
  row_spec(which(local_clusters$cluster_type == "High-high cluster"), bold = TRUE, background = "#fff3cd") %>%
  row_spec(which(local_clusters$cluster_type == "Outlier (low amid high)"), italic = TRUE, background = "#e3f2fd")
```

```{r, Load Data for Exemption Analysis}
school_data <- read_csv("Pennsylvania school immunization rates, 2025-2026 – Pennsylvania school immunization rates.csv") %>%
  filter(Grade == "Kindergarten") %>%
  mutate(
    mmr_pct = as.numeric(str_remove(`MMR Percent`, "%")),
    religious_pct = as.numeric(str_remove(`Religious Exemption Percent`, "%")),
    philosophical_pct = as.numeric(str_remove(`Philosophical Exemption Percent`, "%")),
  ) %>%
  filter(!is.na(mmr_pct))
county_variance <- school_data %>%
  group_by(County) %>%
  summarize(
    n_schools = n(),
    sd_mmr = sd(mmr_pct, na.rm = TRUE),
    range_mmr = max(mmr_pct, na.rm = TRUE) - min(mmr_pct, na.rm = TRUE),
    mean_religious_exemption = mean(religious_pct, na.rm = TRUE),
    mean_philosophical_exemption = mean(philosophical_pct, na.rm = TRUE)
  ) %>%
  rename(county = County)
pa_data <- pa_data %>%
  left_join(county_variance, by = "county")
# Forest County omitted as it has only two K schools with 8 and 17 students.
```

