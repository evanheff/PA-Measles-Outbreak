```{r, Libraries}
library(tidyverse)
library(readxl)
library(kableExtra)
library(ggrepel)
library(pscl)
library(patchwork)
```

```{r, Setup Data}
vax_rates <- read_excel("PA Measles Outbreak Analysis.xlsx", sheet = "Kindergarten MMR Vax Rates")
case_counts <- read_excel("PA Measles Outbreak Analysis.xlsx", sheet = "Case Counts (8-17)") #Change Date Here
population_density <- read_excel("PA Measles Outbreak Analysis.xlsx", sheet = "Population Density")
pa_data <- vax_rates %>%
  left_join(case_counts, by = "county") %>%
  left_join(population_density, by =  "county") %>%
  mutate(
    cases_per_100k = `case count` / population * 100000,
    below_herd_immunity = `vaccination rate` < 0.95
  )
```

```{r, Density and Vaccination Rate vs. Case Count}
ggplot(pa_data, aes(x = density, y = `vaccination rate`)) +
  geom_hline(yintercept = 0.95, linetype = "dashed", color = "red") +
  geom_point(
    data = filter(pa_data, `case count` == 0),
    shape = 21, fill = "white", color = "black", size = 1.5
  ) +
  geom_point(
    data = filter(pa_data, `case count` > 0),
    aes(size = `case count`, color = `case count`),
    alpha = 0.7
  ) +
  geom_text_repel(
    data = filter(pa_data, `case count` > 0),
    aes(label = county), size = 2
  ) +
  scale_x_log10(labels = comma) +
  scale_color_viridis_c(option = "plasma") +
  scale_size_continuous(range = c(2, 12)) +
  labs(
    title = "Vaccination Rate and Population Density vs. Measles Case Count",
    x = "Population Density: log(population per square mile)",
    y = "Kindergarten MMR Vaccination Rate",
    size = "Case Count",
    color = "Case Count"
  ) +
  theme_classic()
```

