```{r}
# County Boundaries
pa_counties <- counties(state = "PA", cb = TRUE, year = 2022, class = "sf") %>%
  dplyr::select(county = NAME, geometry)

# Remove two virtual charter schools with addresses in Dauphin County (Harrisburg)
school_data_filtered <- school_data %>%
  filter(!School %in% c("Reach Cyber CS", "Commonwealth Charter Academy CS"))
# County-Level Metrics
county_map_data <- school_data_filtered %>%
  filter(!is.na(mmr_pct)) %>%
  group_by(County) %>%
  summarize(
    total_enrolled                = sum(`Total Students Enrolled`, na.rm = TRUE),
    enrolled_below_95             = sum(`Total Students Enrolled`[mmr_pct < 95], na.rm = TRUE),
    pct_students_below_95         = enrolled_below_95 / total_enrolled,
    weighted_religious_exemption  = sum(`Total Students Enrolled` * religious_pct, na.rm = TRUE) / total_enrolled,
    worst_school_mmr              = min(mmr_pct, na.rm = TRUE),
    kids_in_severe_pocket         = sum(`Total Students Enrolled`[mmr_pct < 70], na.rm = TRUE)
  ) %>%
  rename(county = County)
map_data <- pa_counties %>%
  left_join(county_map_data, by = "county")

# Map 1: enrollment-weighted share below 95%
map1 <- ggplot(map_data) +
  geom_sf(aes(fill = pct_students_below_95), color = "white", linewidth = 0.2) +
  scale_fill_viridis_c(option = "mako", labels = scales::percent, name = "% kindergartners below 95% MMR") +
  labs(title = "Share below herd-immunity threshold (county-wide average)") +
  theme_void(base_size = 11)

# Map 2: enrollment-weighted mean religious exemption rate
map2 <- ggplot(map_data) +
  geom_sf(aes(fill = weighted_religious_exemption), color = "white", linewidth = 0.2) +
  scale_fill_viridis_c(option = "mako", labels = scales::percent_format(scale = 1), name = "Weighted mean religious exemption") +
  labs(title = "Religious exemption rate (county-wide average)") +
  theme_void(base_size = 11)

# Map 3: worst single school per county
map3 <- ggplot(map_data) +
  geom_sf(aes(fill = worst_school_mmr), color = "white", linewidth = 0.2) +
  scale_fill_viridis_c(option = "viridis", labels = scales::percent_format(scale = 1), name = "Lowest single school MMR rate") +
  labs(title = "Most severe school per county (pocket detection)") +
  theme_void(base_size = 11)

# Map 4: absolute number of kids in severely under-vaccinated schools
map4 <- ggplot(map_data) +
  geom_sf(aes(fill = kids_in_severe_pocket), color = "white", linewidth = 0.2) +
  scale_fill_viridis_c(option = "viridis", name = "Children in schools below 70% MMR") +
  labs(title = "Size of severe pocket (absolute count)") +
  theme_void(base_size = 11)

# Map 5: cases per 1000 per county
map_data <- map_data %>%
  left_join(pa_data %>% dplyr::select(county, `case count`, population), by = "county")
map5 <- ggplot(map_data) +
  geom_sf(aes(fill = (`case count` / population) * 100000), color = "white", linewidth = 0.2) +
  scale_fill_viridis_c(option = "plasma", name = "Cases per 100,000 per County") +
  labs(title = "Cases per 100,000 per County", subtitle = paste("As of", Sys.Date())) +
  theme_void(base_size = 11)
print(map1)
print(map2)
print(map3)
print(map4)
print(map5)
