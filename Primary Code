```{r, Correlations With Case Count Over Time}
compute_correlations <- function(df) {
  tibble(
    pair = c("Density vs. Cases", "Vaccination Rate vs. Cases"),
    pearson = c(
      cor(df$density, df$cases, method = "pearson"),
      cor(df$vax_rate, df$cases, method = "pearson")
    ),
    spearman = c(
      cor(df$density, df$cases, method = "spearman"),
      cor(df$vax_rate, df$cases, method = "spearman")
    ),
    kendall = c(
      cor(df$density, df$cases, method = "kendall"),
      cor(df$vax_rate, df$cases, method = "kendall")
    )
  )
}

