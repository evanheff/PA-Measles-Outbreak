```{r, Refit NB and ZINB Across All Snapshots}
model_inputs <- pull_dates %>%
  mutate(
    fit_data = map(sheet_suffix, function(s) {
      sheet_name <- paste0("Case Counts (", s, ")")
      read_excel("PA Measles Outbreak Analysis.xlsx", sheet = sheet_name) %>%
        rename(cases = `case count`) %>%
        left_join(vax_rates, by = "county") %>%
        left_join(population_density, by = "county") %>%
        rename(vax_rate = `vaccination rate`)
    })
  )

fit_one_date <- function(df) {
  nb_fit <- MASS::glm.nb(cases ~ vax_rate + density + offset(log(population)), data = df)
  zinb_fit <- zeroinfl(cases ~ vax_rate + density + offset(log(population)) | 1, data = df, dist = "negbin")

  nb_coef <- coef(summary(nb_fit))
  zinb_coef <- coef(summary(zinb_fit))$count
  zi_intercept <- coef(summary(zinb_fit))$zero["(Intercept)", "Estimate"]

  tibble(
    model = c("NB", "NB", "ZINB", "ZINB"),
    term = c("Vaccination Rate", "Density", "Vaccination Rate", "Density"),
    estimate = c(
      nb_coef["vax_rate", "Estimate"], nb_coef["density", "Estimate"],
      zinb_coef["vax_rate", "Estimate"], zinb_coef["density", "Estimate"]
    ),
    se = c(
      nb_coef["vax_rate", "Std. Error"], nb_coef["density", "Std. Error"],
      zinb_coef["vax_rate", "Std. Error"], zinb_coef["density", "Std. Error"]
    ),
    aic_nb = AIC(nb_fit),
    aic_zinb = AIC(zinb_fit),
    zi_intercept = zi_intercept
  )
}

model_over_time <- model_inputs %>%
  mutate(model_results = map(fit_data, fit_one_date)) %>%
  dplyr::select(pull_date, model_results) %>%
  unnest(model_results)
```

